# Configuración del envío de correo.
#
# Copia este fichero a `.env.veta-estudio-creativo` (el nombre lleva el id del
# proyecto de Firebase) y rellena SMTP_USER y SMTP_FROM.
#
# La contraseña NO va aquí. Va en Secret Manager:
#   firebase functions:secrets:set SMTP_PASSWORD

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=la-cuenta@gmail.com
SMTP_FROM=Veta · Estudio Creativo <la-cuenta@gmail.com>
